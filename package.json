{
  "name": "opendata-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de inteligencia de datos con API públicas, gratuitas y sin autenticación",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:test": "bash scripts/db-test.sh",
    "ingest": "tsx apps/worker/src/cli.ts",
    "admission": "bash scripts/admission-probe.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
